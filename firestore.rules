rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for RSVPs
    function isValidRSVP(data) {
      return data.keys().hasAll(['id', 'name', 'status', 'guestsCount', 'timestamp'])
        && data.keys().size() <= 6
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (data.status == 'attending' || data.status == 'declined')
        && data.guestsCount is int && data.guestsCount >= 0 && data.guestsCount <= 50
        && data.timestamp is string && data.timestamp.size() <= 50
        && (!data.keys().hasAny(['dietaryNotes']) || (data.dietaryNotes is string && data.dietaryNotes.size() <= 1000));
    }

    // Validation for Wishes
    function isValidWish(data) {
      return data.keys().hasAll(['id', 'name', 'wishText', 'relationship', 'timestamp'])
        && data.keys().size() == 5
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.wishText is string && data.wishText.size() > 0 && data.wishText.size() <= 2000
        && (data.relationship == 'family' || data.relationship == 'friend' || data.relationship == 'colleague' || data.relationship == 'wellwisher')
        && data.timestamp is string && data.timestamp.size() <= 50;
    }

    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create: if isValidId(rsvpId) && isValidRSVP(request.resource.data);
      allow delete: if isValidId(rsvpId);
      allow update: if false;
    }

    match /wishes/{wishId} {
      allow read: if true;
      allow create: if isValidId(wishId) && isValidWish(request.resource.data);
      allow delete: if isValidId(wishId);
      allow update: if false;
    }
  }
}
